  "templates": {
    "job": "browser-tests",
    "command": "python scripts/verify_tool_templates.py",
    "required_layers": [
      "structural",
      "logic",
      "browser"
    ]
  },
  "validation": {
    "job": "python-project",
    "commands": [
      "python scripts/validate_registry.py --json --no-report",
      "python scripts/check_project.py --json --no-report",
      "python scripts/verify_tools.py --json --no-report",
      "python scripts/project_status.py --check-only --no-report --json",
      "git diff --check",
      "git diff --check <validated-event-base> HEAD"
    ]
  },
  "jobs": {
    "python-project": {
      "runner": "windows-2022",
      "command": "python scripts/ci/run.py python-project"
    },
    "node-regression": {
      "runner": "ubuntu-24.04",
      "command": "python scripts/ci/run.py node-regression"
    },
    "browser-tests": {
      "runner": "ubuntu-22.04",
      "command": "python scripts/ci/run.py browser-tests"
    }
  },
  "runtimes": {
    "python": "3.14.4",
    "node": "24.22.1",
    "playwright": "1.64.1"
  },
  "exclusions": [
    {
      "scope": "public-live-publication",
      "reason": "CI is isolated/offline; requires separate genuine deployment and canonical public source/live checks."
    },
    {
      "scope": "installed-native-shortcuts-and-OS-dialogs",
      "reason": "Only temporary Windows COM/Tk fixtures run in CI; actual owner shortcuts, clipboard, Save dialog, IME, physical devices and screen reader remain manual."
    }
  ],
  "minimum_tests": {
    "python-project": 142,
    "node-regression": 230,
    "browser-tests": 274
  },
  "aggregate": {
    "job": "required-checks",
    "runner": "ubuntu-24.04",
    "command": "python scripts/ci/required_checks.py",
    "requires": [
      "python-project",
      "node-regression",
      "browser-tests"
    ]
  }
