      "id": "layout-320",
      "width": 320,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "Title"
        },
        {
          "action": "set",
          "selector": "#intro",
          "value": "Hello"
        },
        {
          "action": "set",
          "selector": "#links",
          "value": "https://example.com"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": "Title\n\nHello\n\nhttps://example.com"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
