{
  "schema_version": 1,
  "cases": [
    {
      "id": "normal",
      "input": "Title",
      "options": {
        "intro": "Hello",
        "sections": "One\n---\nTwo",
        "links": "https://example.com"
      },
      "expected": "Title\n\nHello\n\nOne\n\nTwo\n\nhttps://example.com"
    },
    {
      "id": "order",
      "input": "Title",
      "options": {
        "intro": "Hello",
        "links": "A",
        "sectionOrder": "links,intro,sections,timestamps,hashtags"
      },
      "expected": "Title\n\nA\n\nHello"
    },
    {
      "id": "unicode",
      "input": "Vídeo",
      "options": {
        "hashtags": "#😀"
      },
      "expected": "Vídeo\n\n#😀"
    },
    {
      "id": "empty",
      "input": "",
      "options": {},
      "error": "title"
    },
    {
      "id": "bad-order",
      "input": "T",
      "options": {
        "sectionOrder": "intro,intro"
      },
      "error": "order"
    },
    {
      "id": "big",
      "input": "T",
      "options": {
        "intro": ""
      },
      "error": "5,000"
    },
    {
      "id": "unsafe-text",
      "input": "T",
      "options": {
        "links": "<img src=x>"
      },
      "expected": "T\n\n<img src=x>"
    }
  ]
}
