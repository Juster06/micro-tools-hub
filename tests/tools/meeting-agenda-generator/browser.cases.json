          "value": "Welcome"
        },
        {
          "action": "set",
          "selector": "#item-duration-0",
          "value": "10"
        },
        {
          "action": "set",
          "selector": "#item-presenter-0",
          "value": "Ada"
        },
        {
          "action": "click",
          "selector": "#addBtn"
        },
        {
          "action": "set",
          "selector": "#item-name-1",
          "value": "Discuss"
        },
        {
          "action": "set",
          "selector": "#item-duration-1",
          "value": "25"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": "Meeting: Planning ☕\nDate: 2026-03-01\nAgenda:\n1. Welcome (10 min) — Ada\n2. Discuss (25 min)\nTotal: 35 minutes"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
