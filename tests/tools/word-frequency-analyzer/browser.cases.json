{
  "schema_version": 1,
  "cases": [
    {
      "id": "native-enter-and-result",
      "width": 320,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "Dog dog DOG dog"
        },
        {
          "action": "focus",
          "selector": "#runBtn"
        },
        {
          "action": "key",
          "key": "Enter"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "Unique words: 3"
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "equals": "Complete."
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
      ]
    },
    {
      "id": "copy-and-reset",
      "width": 768,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "Dog dog DOG dog"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "$clipboard",
          "property": "text",
          "includes": "Unique words: 3"
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#copyBtn",
          "property": "disabled",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    },
    {
      "id": "copy-denied-fallback",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "Dog dog DOG dog"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "clipboard",
          "mode": "failure"
        },
        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolOutput"
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "includes": "Output selected"
        }
      ]
    },
    {
      "id": "unicode-normalized-count",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "\u00e9 e\u0301 e\u0301"
        },
        {
          "action": "set",
          "selector": "#normalization",
          "value": "NFC"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "\u00e9\t3"
        }
      ]
    }
  ]
}
