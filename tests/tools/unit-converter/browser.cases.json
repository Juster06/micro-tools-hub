          "equals": true
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "equals": "Complete."
        },
        {
          "action": "clipboard",
          "mode": "failure"
        },
        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "includes": "Output selected"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolOutput"
        }
      ]
    },
