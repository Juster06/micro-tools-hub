{
  "schema_version": 1,
  "cases": [
    {
      "id": "extract-and-reset",
      "width": 320,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "name,name\nAda,Bee"
        },
        {
          "action": "set",
          "selector": "#columns",
          "value": "2,1"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "Bee,Ada"
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
      ]
    },
    {
      "id": "invalid-quote",
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "x,\"bad"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        }
      ]
    }
  ]
}
