{
  "schema_version": 1,
  "cases": [
    {
      "id": "empty-reset",
      "width": 375,
      "steps": [
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    }
  ]
}
