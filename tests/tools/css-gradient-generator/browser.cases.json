{
  "schema_version": 1,
  "cases": [
    {
      "id": "native-enter-and-result",
      "width": 320,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "#123ABC 0%\n#00FF00 100%"
        },
        {
          "action": "focus",
          "selector": "#runBtn"
        },
        {
          "action": "key",
          "key": "Enter"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "linear-gradient(90deg, #123abc 0%, #00ff00 100%)"
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "equals": "Complete."
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
      ]
    },
    {
      "id": "copy-and-reset",
      "width": 768,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "#123ABC 0%\n#00FF00 100%"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "$clipboard",
          "property": "text",
          "includes": "linear-gradient(90deg, #123abc 0%, #00ff00 100%)"
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#copyBtn",
          "property": "disabled",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    },
    {
      "id": "copy-denied-fallback",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "#123ABC 0%\n#00FF00 100%"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "clipboard",
          "mode": "failure"
        },
        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolOutput"
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "includes": "Output selected"
        }
      ]
    },
    {
      "id": "live-radial-preview",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "#123ABC 0%\n#00FF00 100%"
        },
        {
          "action": "set",
          "selector": "#type",
          "value": "radial"
        },
        {
          "action": "expect",
          "selector": "#angle",
          "property": "disabled",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "#gradientPreview",
          "property": "hidden",
          "equals": false
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "radial-gradient(circle at center"
        }
      ]
    },
    {
      "id": "invalid-stops-clear-preview",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "#123ABC 0%\n#00FF00 100%"
        },
        {
          "action": "expect",
          "selector": "#gradientPreview",
          "property": "hidden",
          "equals": false
        },
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "url(https://example.invalid/)"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#gradientPreview",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        },
        {
          "action": "expect",
          "selector": "#copyBtn",
          "property": "disabled",
          "equals": true
        }
      ]
    }
  ]
}
