{
  "schema_version": 1,
  "cases": [
    {
      "id": "no-file",
      "width": 320,
      "steps": [
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
      ]
    },
    {
      "id": "reset",
      "steps": [
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#desktopPreview",
          "property": "hidden",
          "equals": true
        }
      ]
    }
  ]
}
