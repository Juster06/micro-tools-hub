{
  "schema_version": 1,
  "cases": [
    {
      "id": "generate-download-reset",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "Local QR"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#downloadBtn",
          "property": "disabled",
          "equals": false
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": "Local QR"
        },
        {
          "action": "click",
          "selector": "#downloadBtn"
        },
        {
          "action": "expect",
          "selector": "$downloads",
          "property": "count",
          "equals": 1
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#qrPreview",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    },
    {
      "id": "empty-error",
      "width": 375,
      "steps": [
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        },
        {
          "action": "expect",
          "selector": "#downloadBtn",
          "property": "disabled",
          "equals": true
        }
      ]
    }
  ]
}
