{
  "schema_version": 1,
  "cases": [
    {
      "id": "defaults-and-reset",
      "steps": [
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#copyBtn",
          "property": "disabled",
          "equals": true
        },
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "b\na\nb"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "b\na"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "equals": "Complete."
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    },
    {
      "id": "copy-and-download",
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "b\na\nb"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "b\na"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "equals": "Complete."
        },
        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "$clipboard",
          "property": "text",
          "includes": "b\na"
        },
        {
          "action": "click",
          "selector": "#downloadBtn"
        },
        {
          "action": "expect",
          "selector": "$downloads",
          "property": "text",
          "includes": "b\na"
        }
      ]
    },
    {
      "id": "denied-copy",
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "b\na\nb"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
