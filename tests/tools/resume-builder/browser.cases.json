          "equals": "Ada <engineer>"
        },
        {
          "action": "expect",
          "selector": "#resumePreview",
          "property": "textContent",
          "equals": "Ada <engineer>"
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    }
  ]
}
