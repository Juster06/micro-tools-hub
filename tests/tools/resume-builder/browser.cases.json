{
  "schema_version": 1,
  "cases": [
    {
      "id": "safe-preview-reset",
      "width": 375,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "Ada <engineer>"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
