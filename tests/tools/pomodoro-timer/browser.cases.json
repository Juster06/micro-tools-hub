{
  "schema_version": 1,
  "cases": [
    {
      "id": "start-pause-reset",
      "width": 320,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "1"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#timerPhase",
          "property": "textContent",
          "equals": "Work"
        },
        {
          "action": "click",
          "selector": "#pauseBtn"
        },
        {
          "action": "expect",
          "selector": "#runBtn",
          "property": "textContent",
          "equals": "Resume"
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": "25"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
      ]
    },
    {
      "id": "invalid",
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "0"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        }
      ]
    }
  ]
}
