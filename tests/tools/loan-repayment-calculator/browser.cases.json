{
  "schema_version": 1,
  "cases": [
    {
      "id": "calculate-and-clear",
      "width": 320,
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "1000"
        },
        {
          "action": "set",
          "selector": "#rate",
          "value": "10"
        },
        {
          "action": "set",
          "selector": "#frequency",
          "value": "1"
        },
        {
          "action": "set",
          "selector": "#years",
          "value": "2"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "Total repayment: 1152.38"
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "overflow",
          "equals": false
        }
      ]
    },
    {
      "id": "invalid",
      "steps": [
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "-1"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": false
        }
      ]
    }
  ]
}
