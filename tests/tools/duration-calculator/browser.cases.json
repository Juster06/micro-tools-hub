{
  "schema_version": 1,
  "cases": [
    {
      "id": "defaults-and-reset",
      "steps": [
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#copyBtn",
          "property": "disabled",
          "equals": true
        },
        {
          "action": "set",
          "selector": "#toolInput",
          "value": "00:59:59\n00:00:01"
        },
        {
          "action": "click",
          "selector": "#runBtn"
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "includes": "01:00:00.000"
        },
        {
          "action": "expect",
          "selector": "#toolError",
          "property": "hidden",
          "equals": true
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "equals": "Complete."
        },
        {
          "action": "click",
          "selector": "#clearBtn"
        },
        {
          "action": "expect",
          "selector": "#toolInput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "#toolOutput",
          "property": "value",
          "equals": ""
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolInput"
        }
      ]
    },
    {
