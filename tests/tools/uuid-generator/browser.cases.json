        {
          "action": "click",
          "selector": "#copyBtn"
        },
        {
          "action": "expect",
          "selector": "$page",
          "property": "activeId",
          "equals": "toolOutput"
        },
        {
          "action": "expect",
          "selector": "#toolStatus",
          "property": "textContent",
          "includes": "Ctrl+C"
        }
